<?xml version="1.0"?>
<!-- Scissor-UMI (2f-140) handheld. Generated by scissor-umi/cad/urdf.py. base_link = the gripper frame G =
     the robot's robotiq_arg2f_base_link: the jaws, the D405 and the Quest ring sit at the same transforms on both.
     q = finger_joint: 0 open, 0.7 closed (read from the STS3215 on the handle axle: q = 2 x its angle). -->
<robot name="scissor_umi_2f140">
  <link name="base_link"/>
  <link name="left_outer_link"/>
  <joint name="finger_joint" type="revolute">
    <parent link="base_link"/><child link="left_outer_link"/>
    <origin xyz="0 -0.03060 0.05491" rpy="2.29590 0 0.00000"/>
    <axis xyz="-1 0 0"/><limit lower="0" upper="0.7" effort="20" velocity="2"/>
  </joint>
  <link name="left_finger"/>
  <joint name="left_finger_joint" type="revolute">
    <parent link="left_outer_link"/><child link="left_finger"/>
    <origin xyz="0 0.09998 -0.00222" rpy="-0.72500 0 0"/>
    <axis xyz="1 0 0"/><limit lower="0" upper="0.7" effort="20" velocity="2"/>
    <mimic joint="finger_joint" multiplier="1"/>
  </joint>
  <link name="left_pad"/>
  <joint name="left_pad_joint" type="fixed">
    <parent link="left_finger"/><child link="left_pad"/>
    <origin xyz="0 0.04576 -0.02722" rpy="0 0 0"/>
  </joint>
  <link name="right_outer_link"/>
  <joint name="right_outer_knuckle_joint" type="revolute">
    <parent link="base_link"/><child link="right_outer_link"/>
    <origin xyz="0 0.03060 0.05491" rpy="2.29590 0 3.14159"/>
    <axis xyz="-1 0 0"/><limit lower="0" upper="0.7" effort="20" velocity="2"/><mimic joint="finger_joint" multiplier="1"/>
  </joint>
  <link name="right_finger"/>
  <joint name="right_finger_joint" type="revolute">
    <parent link="right_outer_link"/><child link="right_finger"/>
    <origin xyz="0 0.09998 -0.00222" rpy="-0.72500 0 0"/>
    <axis xyz="1 0 0"/><limit lower="0" upper="0.7" effort="20" velocity="2"/>
    <mimic joint="finger_joint" multiplier="1"/>
  </joint>
  <link name="right_pad"/>
  <joint name="right_pad_joint" type="fixed">
    <parent link="right_finger"/><child link="right_pad"/>
    <origin xyz="0 0.04576 -0.02722" rpy="0 0 0"/>
  </joint>
  <link name="d405_optical_frame"/>
  <joint name="d405_optical_joint" type="fixed">
    <parent link="base_link"/><child link="d405_optical_frame"/>
    <origin xyz="0.07463 0.00000 0.00915" rpy="-0.13963 -0.00000 -1.57080"/>
  </joint>
  <link name="quest_ring_frame"/>
  <joint name="quest_ring_joint" type="fixed">
    <parent link="base_link"/><child link="quest_ring_frame"/>
    <origin xyz="0.13000 0.00000 -0.01200" rpy="0.00000 -0.00000 0.00000"/>
  </joint>
</robot>
