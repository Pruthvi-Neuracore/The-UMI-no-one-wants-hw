<?xml version="1.0"?>
<!-- The Scissor-UMI head on a Robotiq 2f-140: include after the gripper's own URDF/xacro.
     The ISO 50 collar puts the coupling 6 mm further from the flange: add 0.006 m to the
     flange -> coupling joint (the flange face is now at z = -0.0210 m in robotiq_arg2f_base_link). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="scissor_umi_head" params="prefix:='' parent:=robotiq_arg2f_base_link">
  <link name="${prefix}d405_optical_frame"/>
  <joint name="${prefix}d405_optical_joint" type="fixed">
    <parent link="${parent}"/><child link="${prefix}d405_optical_frame"/>
    <origin xyz="0.07180 0.00000 0.04810" rpy="-0.52360 0.00000 1.57080"/>
  </joint>
  <link name="${prefix}quest_ring_frame"/>
  <joint name="${prefix}quest_ring_joint" type="fixed">
    <parent link="${parent}"/><child link="${prefix}quest_ring_frame"/>
    <origin xyz="0.07500 0.02722 -0.05605" rpy="0.00000 -0.00000 0.00000"/>
  </joint>
  </xacro:macro>
</robot>
